SITE_NAME="R Games Studio"
MAIN_DOMAIN_URL=https://your-app.vercel.app
GAMES_DOMAIN_URL=https://games.yourdomain.com
PUBLIC_CDN_BASE_URL=https://media.yourdomain.com
ALLOWED_ORIGINS=https://your-app.vercel.app

# Neon/Supabase pooled connection string
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Generate: openssl rand -base64 48
SESSION_SECRET=
VISITOR_HASH_SALT=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Vercel pe "s3" hi use karo ("local" kaam nahi karega)
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_GAMES=rgames-builds
S3_BUCKET_MEDIA=rgames-media
S3_BUCKET_TEMP=rgames-temp

RATE_LIMIT_DRIVER=postgres
