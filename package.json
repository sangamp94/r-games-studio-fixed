{
  "name": "r-games-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:no-emoji": "tsx scripts/check-no-emoji.ts",
    "lint": "npm run check:no-emoji && next lint && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma migrate deploy && next build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.680.0",
    "@aws-sdk/s3-request-presigner": "^3.680.0",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "yauzl": "^3.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.8.0",
    "@types/react": "^19.0.0",
    "@types/yauzl": "^2.10.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "yazl": "^2.5.1",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20"
  }
}